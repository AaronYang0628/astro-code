{
  "name": "astro-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "tsx src/orchestrator/index.ts",
    "run:mvp": "tsx src/orchestrator/index.ts --request examples/request.radec.json --playbook playbooks/euclid_desi_mvp.playbook.md --config pipeline.config.yaml",
    "test": "tsx src/orchestrator/__tests__/gates.test.ts",
    "check:euclid-tile": "tsx scripts/check-euclid-tile.ts",
    "deploy:k8s": "bash ops/oneclick-deploy.sh k8s",
    "deploy:dev": "bash ops/oneclick-deploy.sh dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.204.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
